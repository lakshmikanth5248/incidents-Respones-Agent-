# ==============================================================================
# UNIFIED PROJECT CONFIGURATION TEMPLATE (.env.example)
# Aegis Incident Response Agent + Hindsight Memory Engine + Control Plane + Frontend
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DATABASE SETTINGS (Backend)
# ------------------------------------------------------------------------------
APP_ENV=development
DATABASE_URL=sqlite:///./incident_agent.db
LOG_LEVEL=INFO
API_PREFIX=/api
DEFAULT_OPERATOR=sre-operator

# ------------------------------------------------------------------------------
# 2. SECURITY, CORS & PAYLOADS
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000
MAX_SYMPTOM_LENGTH=10000
MAX_PAYLOAD_BYTES=1048576
JWT_SECRET=aegis-command-production-sre-jwt-secret-key-2026

# ------------------------------------------------------------------------------
# 3. VECTORIZE HINDSIGHT MEMORY SERVICE (Backend -> Hindsight Engine)
# ------------------------------------------------------------------------------
HINDSIGHT_ENDPOINT=http://localhost:8888
HINDSIGHT_BANK_ID=incident-response-bank
HINDSIGHT_USE_TEST_DOUBLE=false
HINDSIGHT_TIMEOUT_SECONDS=10.0
HINDSIGHT_MAX_RETRIES=2
# HINDSIGHT_API_KEY=your_hindsight_api_key

# ------------------------------------------------------------------------------
# 4. HINDSIGHT ENGINE LOCAL SERVER (hindsight-engine)
# ------------------------------------------------------------------------------
HINDSIGHT_API_PORT=8888
HINDSIGHT_API_DATABASE_URL=sqlite:///./hindsight.db
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
# HINDSIGHT_API_LLM_API_KEY=sk-...

# ------------------------------------------------------------------------------
# 5. FRONTEND & CONTROL PLANE CLIENT SETTINGS
# ------------------------------------------------------------------------------
PORT=3000
VITE_API_URL=http://localhost:8000
HINDSIGHT_API_URL=http://localhost:8888

# ------------------------------------------------------------------------------
# 6. MODEL PROVIDER (AI Agent Reasoning & Interpretation)
# ------------------------------------------------------------------------------
MODEL_PROVIDER=mock
MODEL_NAME=mock-reasoner-v1
# MODEL_API_KEY=your_model_api_key

# Optional / External Integration Keys
# GEMINI_API_KEY=
# APP_URL=http://localhost:3000
