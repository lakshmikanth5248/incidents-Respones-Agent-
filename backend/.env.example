# Application Environment (development, demo, production)
APP_ENV=development

# Database Connection (SQLite by default for local development, or PostgreSQL URL)
DATABASE_URL=sqlite:///./incident_agent.db

# Logging
LOG_LEVEL=INFO

# Security & CORS
CORS_ORIGIN=http://localhost:3000
MAX_SYMPTOM_LENGTH=10000
MAX_PAYLOAD_BYTES=1048576

# API Configuration
API_PREFIX=/api

# Vectorize Hindsight Memory Service Configuration
HINDSIGHT_ENDPOINT=http://localhost:8888
HINDSIGHT_BANK_ID=incident-response-bank
HINDSIGHT_USE_TEST_DOUBLE=false
HINDSIGHT_TIMEOUT_SECONDS=10.0
HINDSIGHT_MAX_RETRIES=2
# HINDSIGHT_API_KEY=your_hindsight_api_key_if_auth_enabled

# Model Provider (mock, openai, anthropic)
MODEL_PROVIDER=mock
MODEL_NAME=mock-reasoner-v1
# MODEL_API_KEY=your_model_api_key

