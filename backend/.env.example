# Application Environment (development, demo, production)
APP_ENV=development

# Database Connection (SQLite by default for local development, or PostgreSQL URL)
DATABASE_URL=sqlite:///./incident_agent.db

# Logging
LOG_LEVEL=INFO

# Security & CORS
CORS_ORIGIN=http://localhost:3000
MAX_SYMPTOM_LENGTH=10000
MAX_PAYLOAD_BYTES=1048576

# API Configuration
API_PREFIX=/api

# Future Integrations (Placeholders for Feature 3 & Feature 4)
# HINDSIGHT_ENDPOINT=https://api.vectorize.io/hindsight
# HINDSIGHT_API_KEY=your_hindsight_api_key
# HINDSIGHT_ENTITY_ID=incident-response-agent
# MODEL_PROVIDER=openai
# MODEL_API_KEY=your_model_api_key
# MODEL_NAME=gpt-4o
